# ~/.bashrc — managed by ~/startup (portable core)
# Machine-specific overrides: ~/.bashrc.local

# If not running interactively, don't do anything
case $- in
    *i*) ;;
      *) return;;
esac

# don't put duplicate lines or lines starting with space in the history.
HISTCONTROL=ignoreboth

# append to the history file, don't overwrite it
shopt -s histappend

HISTSIZE=1000
HISTFILESIZE=2000

shopt -s checkwinsize

# make less more friendly for non-text input files
[ -x /usr/bin/lesspipe ] && eval "$(SHELL=/bin/sh lesspipe)"

# set variable identifying the chroot you work in
if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
    debian_chroot=$(cat /etc/debian_chroot)
fi

case "$TERM" in
    xterm-color|*-256color) color_prompt=yes;;
esac

force_color_prompt=yes

if [ -n "$force_color_prompt" ]; then
    if [ -x /usr/bin/tput ] && tput setaf 1 >&/dev/null; then
	color_prompt=yes
    else
	color_prompt=
    fi
fi

if [ "$color_prompt" = yes ]; then
    PS1='${debian_chroot:+($debian_chroot)}\[\033[01;32m\]\u@\h\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]\$ '
else
    PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
fi
unset color_prompt force_color_prompt

## === Prompt Setup ===
parse_git_branch() {
  local branch=""
  if git rev-parse --is-inside-work-tree &>/dev/null; then
    branch=" ($(git rev-parse --abbrev-ref HEAD 2>/dev/null))"
  fi
  echo "$branch"
}

case "$TERM" in xterm*|rxvt*)
    PS1="\[\e]0;${debian_chroot:+($debian_chroot)}\u@\h: \w\a\]$PS1"
    ;;
*)
    ;;
esac

update_ps1() {
  PS1="\[\e[32m\]\w\[\e[36m\]$(parse_git_branch)\[\e[0m\] \$ "
}

PROMPT_COMMAND="update_ps1"

# enable color support of ls and also add handy aliases
if [ -x /usr/bin/dircolors ]; then
    test -r ~/.dircolors && eval "$(dircolors -b ~/.dircolors)" || eval "$(dircolors -b)"
    alias ls='ls --color=auto'
    alias grep='grep --color=auto'
    alias fgrep='fgrep --color=auto'
    alias egrep='egrep --color=auto'
fi

alias ll='ls -alF'
alias la='ls -A'
alias l='ls -CF'

alias alert='notify-send --urgency=low -i "$([ $? = 0 ] && echo terminal || echo error)" "$(history|tail -n1|sed -e '\''s/^\s*[0-9]\+\s*//;s/[;&|]\s*alert$//'\'')"'

if [ -f ~/.bash_aliases ]; then
    . ~/.bash_aliases
fi

if ! shopt -oq posix; then
  if [ -f /usr/share/bash-completion/bash_completion ]; then
    . /usr/share/bash-completion/bash_completion
  elif [ -f /etc/bash_completion ]; then
    . /etc/bash_completion
  fi
fi

j() {
  just "$@"
}
# shellcheck disable=SC2154
if declare -F _just >/dev/null 2>&1; then
  complete -F _just j
fi

# === Custom Aliases ===
alias pbcopy='xclip -selection clipboard'
alias pbpaste='xclip -selection clipboard -o'
alias pwd_pbcopy='pwd | pbcopy'
alias gitlog='git log --all --graph'
alias gits='git status'
alias n='nvim'
alias j='just'
h() {
  # workspace.create needs the API socket; start the headless server first if needed.
  local cwd
  cwd="$(pwd)"
  if ! herdr status --json 2>/dev/null | command grep -q '"running":true'; then
    herdr server >/dev/null 2>&1 &
    local i
    for i in $(seq 1 50); do
      if herdr status --json 2>/dev/null | command grep -q '"running":true'; then
        break
      fi
      sleep 0.1
    done
  fi
  herdr workspace create --cwd "$(pwd)" --focus >/dev/null
  herdr "$@"
}
alias a='agent '
alias volume='du -sh * .* 2>/dev/null | sort -h'
alias serial_ttyacm0='stty -F /dev/ttyACM0 115200 raw -echo && cat /dev/ttyACM0'
alias serial_ttyacm2='stty -F /dev/ttyACM2 115200 raw -echo && cat /dev/ttyACM2'
alias fix_path='sudo update-binfmts --disable cli'

gitworktree_from_dev() {
  if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
    cat <<'EOF'
gitworktree_from_dev — create a git worktree from origin/dev (or custom base)

Usage:
  gitworktree_from_dev <name> [prefix] [base-ref]

Arguments:
  name       Worktree folder name (../<name>) and branch suffix (<prefix>/<name>)
  prefix     Branch prefix (default: feature)
  base-ref   Starting ref (default: origin/dev)

Examples:
  gitworktree_from_dev customer-spec-config
    → branch: feature/customer-spec-config
    → path:   ../customer-spec-config
    → base:   origin/dev

  gitworktree_from_dev perf-bench experiment origin/dev_2
    → branch: experiment/perf-bench
    → path:   ../perf-bench
    → base:   origin/dev_2

Run from the main repo directory.
EOF
    return 0
  fi

  local name="${1:?Usage: gitworktree_from_dev <name> [prefix] [base-ref]  (try --help)}"
  local prefix="${2:-feature}"
  local base="${3:-origin/dev}"
  git worktree add -b "${prefix}/${name}" "../${name}" "${base}"
}

# === COMMAND LINE EDITOR SETTING ===
export EDITOR=nvim
export VISUAL=nvim

# === Keyboard Mode ===
set -o vi

# === Just ===
# WSL: $XDG_RUNTIME_DIR/just is often noexec → shebang recipes get Permission denied.
# Point just temp scripts at an exec-capable dir instead.
export JUST_TEMPDIR=/tmp/just-tmp
mkdir -p "$JUST_TEMPDIR"

# Just Completion
[ -f ~/.just-completion.bash ] && . ~/.just-completion.bash

# === PATH Updates ===
export PATH="/opt/nvim-linux-x86_64/bin:$PATH"
export PATH="$HOME/.local/bin:$PATH"

# tmux completion (optional local file)
[ -f ~/.tmux_completion.bash ] && . ~/.tmux_completion.bash

# login helpers expect GITHUB_TOKEN in the environment (set in ~/.bashrc.local)
alias dockerlogin='echo "$GITHUB_TOKEN" | docker login ghcr.io -u "$USER" --password-stdin'
alias ghlogin='echo "$GITHUB_TOKEN" | gh auth login --with-token'

# zoxide (smart cd: z / zi)
if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init bash)"
fi

# cargo / rustup
if [ -f "$HOME/.cargo/env" ]; then
  . "$HOME/.cargo/env"
fi

# bun (optional)
if [ -d "$HOME/.bun" ]; then
  export BUN_INSTALL="$HOME/.bun"
  export PATH="$BUN_INSTALL/bin:$PATH"
fi

# Machine-specific overrides (TI, Android, Obsidian, tokens, WSL paths)
[ -f "$HOME/.bashrc.local" ] && . "$HOME/.bashrc.local"
