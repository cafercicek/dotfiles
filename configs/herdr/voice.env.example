# Optional local overrides for Herdr voice / Whisper.
# Not installed by default. To enable:
#   cp voice.env.example voice.env
# (or: cp ~/.config/herdr/voice.env.example ~/.config/herdr/voice.env)
#
# This file is sourced by bash — $HOME expands.

# Mic / PulseAudio source (optional; omit to use default device)
# VOICE_SOURCE=RDPSource

# Whisper.cpp (optional; voice-stop.sh has its own defaults under ~/.local/opt/whisper.cpp)
# HERDR_WHISPER_USE_GPU=0
# HERDR_WHISPER_DIR=$HOME/.local/opt/whisper.cpp/whisper-bin-ubuntu-x64
# HERDR_WHISPER_BIN=$HOME/.local/opt/whisper.cpp/whisper-bin-ubuntu-x64/whisper-cli
# HERDR_WHISPER_MODEL=$HOME/.local/opt/whisper.cpp/models/ggml-small.bin
